# ============================================================================
# ChokePoint - Environment Configuration Template
# ============================================================================

# --- 1. LLM Provider (Google Gemini - Free Tier) ---
# Obtain your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use: gemini-2.5-flash (default) or gemini-2.5-pro
AGENT_MODEL=gemini-2.5-flash
AGENT_MAX_ITERATIONS=15

# --- 2. GitHub Access (Optional for local files) ---
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# --- 3. FalkorDB Connection ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# --- 4. Service Ports ---
API_HOST=0.0.0.0
API_PORT=8000
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_AUTH_TOKEN=chokepoint-dev-token

# --- 5. Application Environment ---
LOG_LEVEL=INFO
ENVIRONMENT=development
